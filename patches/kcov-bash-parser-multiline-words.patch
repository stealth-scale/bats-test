-
-				if (trimmed == heredocMarker)
-					state = none;
-				continue;
-			}
-
-			if (s.find("$((") != std::string::npos || s.find("$[") != std::string::npos)
+			if (s.find("$((") != std::string::npos || s.find("$[") != std::string::npos || s.find("((") == 0)
 				arithmeticActive = true;
 
-			if (s[s.size() - 1] == '\\')
+			// A [[ ]] test that spans lines: bash reports the line it ends on, as
