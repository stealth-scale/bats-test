+			}
+
 			// Remove comments
 			size_t comment = s.find("#");
 			if (comment != std::string::npos)
@@ -699,6 +835,10 @@
 			if (s == "esac" || s == "fi" || s == "do" || s == "done" || s == "else" || s == "then")
 				continue;
 
+			// The same endings with what may follow them on their line
