+	// The quote a word of source is in at the end of a line
+	enum WordState
+	{
+		word_none,
+		word_double, // "..."
+		word_single, // '...'
+		word_ansi,   // $'...'
+	};
+
+	// The quote state at the end of a line of source, from the state at its start.
+	// Outside quotes a backslash escapes the next character and # opens a comment.
+	// In "..." and $'...' a backslash escapes the next character; '...' escapes nothing.
+	enum WordState scanWord(const std::string &line, enum WordState state)
+	{
+		for (std::string::size_type i = 0; i < line.size(); ++i)
+		{
+			char c = line[i];
+
+			switch (state)
+			{
+			case word_none:
+				if (c == '\\')
+					i++;
+				else if (c == '#' && (i == 0 || isspace(line[i - 1]) || line[i - 1] == ';'
+						|| line[i - 1] == '(' || line[i - 1] == '|' || line[i - 1] == '&'))
+					return state;
+				else if (c == '"')
+					state = word_double;
+				else if (c == '\'')
+					state = (i > 0 && line[i - 1] == '$') ? word_ansi : word_single;
+				break;
+			case word_double:
+			case word_ansi:
+				if (c == '\\')
+					i++;
+				else if (c == '"' && state == word_double)
+					state = word_none;
+				else if (c == '\'' && state == word_ansi)
+					state = word_none;
+				break;
+			case word_single:
+				if (c == '\'')
+					state = word_none;
+				break;
+			}
+		}
+
+		return state;
+	}
+
+	size_t countOccurrences(const std::string &s, const char *what)
+	{
+		size_t n = 0;
+
+		for (size_t pos = s.find(what); pos != std::string::npos; pos = s.find(what, pos + strlen(what)))
+			n++;
+
+		return n;
+	}
+
+	// fi ;;  esac ;&  done < <(cmd)  done | tee  } 2>/dev/null: a closing keyword
+	// with the terminator of a case item, a redirection, a pipe or & after it.
+	// Bash reports no line for these. "} || return 1" and "fi; cmd" run a command
+	// of their own and stay code.
+	bool isClosingLine(const std::string &s)
+	{
+		static const char *closers[] = { "fi", "done", "esac", "}", NULL };
+
+		for (const char **closer = closers; *closer; closer++)
+		{
+			size_t n = strlen(*closer);
+
+			if (s.size() <= n || s.compare(0, n, *closer) != 0)
+				continue;
+			// finish, done_flag=1
+			if (!isspace(s[n]) && s[n] != ';' && s[n] != '<' && s[n] != '>' && s[n] != '|' && s[n] != '&')
+				continue;
+
+			std::string rest = trim_string(s.substr(n));
+
+			if (rest.compare(0, 2, ";;") == 0 || rest.compare(0, 2, ";&") == 0)
+				return true;
+			if (rest.compare(0, 2, "||") == 0 || rest.compare(0, 2, "&&") == 0 || rest.compare(0, 2, "<<") == 0)
+				return false;
+			if (rest[0] == '<' || rest[0] == '>' || rest[0] == '|' || rest[0] == '&')
+				return true;
+			if (isdigit(rest[0]) && rest.size() > 1 && (rest[1] == '>' || rest[1] == '<'))
+				return true;
+		}
+
+		return false;
+	}
+
 	void parseFileFull(const std::string &filename, const std::vector<std::string> &lines, uint32_t crc)
 	{
 		unsigned int lineNo = 0;
 		enum
 		{
-			none, backslash, quote, heredoc
+			none, backslash, heredoc
 		} state = none;
